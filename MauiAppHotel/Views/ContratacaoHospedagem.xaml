<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EEF2F9" Offset="0.0" />
            <GradientStop Color="#F8FAFC" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10">
        <Label  Text="Cálculo da Diária"
                FontFamily="Kalam"
                FontSize="50"
                HorizontalTextAlignment="Center"
                TextColor ="#0B2545" />

        <BoxView HeightRequest="4"
                 WidthRequest="80"
                 CornerRadius="2"
                 Color="#E0A526"
                 HorizontalOptions="Center"
                 Margin="0,0,0,14" />

        <Frame Padding="16"
               BackgroundColor="White"
               BorderColor="#E5E7EB"
               CornerRadius="20"
               HasShadow="True">
            <VerticalStackLayout Spacing="8">
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*"
                      RowSpacing="10">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos:"
                           FontSize="16"
                           VerticalOptions="Center"
                           TextColor="#1F2937" />

                    <Label Grid.Row="0" Grid.Column="1"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="#0B2545"
                           Text="{Binding Value}" 
                           BindingContext="{x:Reference stp_adultos}"/>

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Crianças:"
                           FontSize="16"
                           VerticalOptions="Center"
                           TextColor="#1F2937" />

                    <Label Grid.Row="1" Grid.Column="1"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="#0B2545"
                           Text="{Binding Value}" 
                           BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />
                </Grid>

                <Label Text="Escolha sua Suíte"
                       FontSize="16"
                       FontAttributes="Bold"
                       Margin="0,8,0,0"
                       TextColor="#0B2545" />

                <Picker x:Name="pck_quarto"
                        Title="Selecione sua Acomodação"
                        TextColor="#0B2545"
                        TitleColor="#6B7280"
                        ItemDisplayBinding="{Binding Descricao}"/>

                <Frame Padding="12"
                       Margin="10"
                       BackgroundColor="#F4F6FA"
                       BorderColor="#E0A526"
                       CornerRadius="16"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Período da Estadia"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#0B2545"/>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Check-in:"
                                   VerticalOptions="Center"
                                   TextColor="#1F2937" />
                            <DatePicker x:Name="dtpck_checkin"
                                        DateSelected="dtpck_checkin_DateSelected"
                                        TextColor="#0B2545"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Check-out:"
                                   VerticalOptions="Center"
                                   TextColor="#1F2937" />
                            <DatePicker x:Name="dtpck_checkout"
                                        TextColor="#0B2545"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="Avançar" Clicked="Button_Clicked" Padding="10" Margin="10"
                        BackgroundColor="#E0A526"
                        TextColor="#0B2545"
                        FontAttributes="Bold"
                        FontSize="17"
                        CornerRadius="14"
                        HeightRequest="52"/>

                <Button Text="Quem somos" Clicked="Button_Clicked_1" Padding="10" Margin="10"
                        BackgroundColor="#0B2545"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="50"/>

            </VerticalStackLayout>
        </Frame>


    </VerticalStackLayout>

</ContentPage>