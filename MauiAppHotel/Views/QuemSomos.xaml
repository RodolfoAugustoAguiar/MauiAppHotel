<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.QuemSomos"
             Title="Quem Somos"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="20"
            VerticalOptions="Center">

            <Frame
                BackgroundColor="White"
                BorderColor="#E0E0E0"
                CornerRadius="15"
                Padding="20"
                HasShadow="True">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Quem Somos"
                        FontSize="32"
                        FontAttributes="Bold"
                        TextColor="#2C3E50"
                        HorizontalOptions="Center" />

                    <BoxView
                        HeightRequest="2"
                        Color="DarkOrange"
                        HorizontalOptions="Fill" />

                    <Label
                        Text="Rodolfo Augusto Aguiar, aluno do curso técnico em Desenvolvimento de Sistemas."
                        FontSize="18"
                        TextColor="#555555"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Programa desenvolvido em 2026."
                        FontSize="18"
                        TextColor="#555555"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Frame>

            <Button
                Text="Voltar"
                Clicked="Button_Clicked"
                BackgroundColor="DarkOrange"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="50"
                Margin="20,10,20,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>